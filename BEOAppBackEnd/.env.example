# Copy to .env (gitignored) and fill in for production. Defaults are dev-safe.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# 0 for production, 1 for development.
DJANGO_DEBUG=1

# Comma-separated. Required when DJANGO_DEBUG=0.
DJANGO_ALLOWED_HOSTS=*

# CORS: in dev DJANGO_CORS_ALLOW_ALL=1 is fine. In prod set =0 and pin origins.
DJANGO_CORS_ALLOW_ALL=1
DJANGO_CORS_ALLOWED_ORIGINS=

# Auth token TTL in days. Tokens older than this are auto-rejected.
DJANGO_AUTH_TOKEN_TTL_DAYS=30

# Per-PDF upload cap.
DJANGO_MAX_UPLOAD_MB=25

# Optional override for the SQLite path.
# DJANGO_DB_PATH=/srv/beo/db.sqlite3
